MONGODB_URI=
MONGODB_DB=content_social_hub

# Owner-only V1 authentication
SESSION_SECRET=
ADMIN_PASSWORD=

# Private media storage
APP_AWS_REGION=us-east-2
S3_MEDIA_BUCKET=content-social-hub-media

# Local development may use an AWS profile or the standard AWS SDK variables.
# Amplify should use its compute role when available.

# Phase 2: Facebook Pages connection
APP_BASE_URL=https://main.d1yfjibipwjpld.amplifyapp.com
META_APP_ID=
META_APP_SECRET=
# Optional when using Facebook Login for Business
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0

# Generate with: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=

# Phase 2: connection-request email
RESEND_API_KEY=
EMAIL_FROM=Content Social Hub <nick@nicholasegner.com>
EMAIL_REPLY_TO=nick@nicholasegner.com
